rules_version = '2';

// Règles de sécurité Firestore — Gabriel LAVEAU
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
//
// Principe :
// - Le kiné (compte e-mail/mot de passe ci-dessous) lit et écrit tout.
// - Un patient n'accède qu'à son propre dossier, grâce à son code d'accès secret
//   (le code fait partie du chemin : patients/{code}). Sans le code, impossible de
//   lister ou de deviner les autres patients.
// - Un patient ne peut modifier que la validation de ses séances (fait / EVA / ressenti)
//   et les jours de ses séances à venir. Il peut ajouter ses réponses aux objectifs
//   et questionnaires, noter ses marches, et écrire des messages à son kiné, sans pouvoir les modifier ensuite.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Qui est qui ----------
    // Titulaire du cabinet : accès complet, seul à gérer les comptes, les réglages,
    // les statistiques et la corbeille.
    function owner() { return "kine.laveau@gmail.com"; }
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [owner()];
    }
    function moi() { return request.auth.token.email.lower(); }
    function acces() { return get(/databases/$(database)/documents/acces/comptes).data; }

    // Compte autorisé par le titulaire (remplaçant, associé) : Réglages du cabinet → Comptes autorisés.
    // Il a SES patients (champ kine = son e-mail) et sa messagerie.
    function isAutorise() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email_verified == true      // adresse prouvée : personne ne peut se faire passer pour lui
        && exists(/databases/$(database)/documents/acces/comptes)
        && moi() in acces().emails;
    }
    function isKine() { return isOwner() || isAutorise(); }

    // Compte à qui le titulaire ouvre ses patients (sans sa messagerie ni ses notes)
    function delegue() { return isAutorise() && moi() in acces().get("delegues", []); }

    // Kiné d'un patient (sans champ : le titulaire)
    function kineDe(data) { return data.get("kine", owner()); }
    function patientDe(cle) { return get(/databases/$(database)/documents/patients/$(cle)).data; }
    // Voir et suivre le patient (programmes, bilans, fiche)
    function peutVoir(data) { return isOwner() || (isAutorise() && (kineDe(data) == moi() || (delegue() && kineDe(data) == owner()))); }
    function peutCle(cle) { return isOwner() || (isAutorise() && peutVoir(patientDe(cle))); }
    // Messagerie et notes privées : le kiné du patient seulement
    function sienCle(cle) { return isOwner() || (isAutorise() && kineDe(patientDe(cle)) == moi()); }
    // Requêtes de liste (le champ kine doit être filtré dans la requête)
    function listeOk() { return isOwner() || (isAutorise() && (resource.data.kine == moi() || (delegue() && resource.data.kine == owner()))); }

    // Champs qu'un patient a le droit de modifier sur une séance
    function isValidation() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(["terminee", "eva", "dateValidation", "ressenti", "commentaire", "dureeReelle"])
        && d.terminee == true
        && (!("eva" in d) || (d.eva is int && d.eva >= 0 && d.eva <= 10))
        && (!("commentaire" in d) || (d.commentaire is string && d.commentaire.size() <= 1000))
        && (!("ressenti" in d) || (d.ressenti is string && d.ressenti.size() <= 30));
    }

    // Le patient peut déplacer une séance non faite (changement de jours)
    function isReplanning() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(["datePrevue", "datePrevueTexte", "joursProgramme", "updatedAt"])
        && resource.data.terminee != true
        && d.datePrevue is string && d.datePrevue.size() <= 40
        && (!("joursProgramme" in d) || (d.joursProgramme is list && d.joursProgramme.size() <= 7));
    }

    match /patients/{cle} {
      allow get: if true;                 // seulement si on connaît le code exact
      allow list: if listeOk();
      allow create: if isOwner() || (isAutorise() && request.resource.data.kine == moi());
      allow update: if isOwner() || (isAutorise() && peutVoir(resource.data) && kineDe(request.resource.data) == kineDe(resource.data));
      allow delete: if isOwner() || (isAutorise() && kineDe(resource.data) == moi());

      match /seances/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create, delete: if peutCle(cle);
        allow update: if peutCle(cle) || isValidation() || isReplanning();
      }

      // Messages du patient au kiné : patients créés avant la version 2.29 (voir codes/ plus bas)
      match /messages/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create: if sienCle(cle) || isMessage();
        allow delete: if sienCle(cle);
        // Le patient peut seulement marquer comme lu un message reçu de son kiné
        allow update: if sienCle(cle) || (resource.data.de == "kine"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lu"]));
      }

      // Rappels de séance : abonnement aux notifications du téléphone du patient
      match /rappels/{id} {
        allow read, delete: if true;      // le chemin contient déjà le code secret
        allow create, update: if peutCle(cle) || isRappel();
      }

      // Objectifs notés et questionnaires remplis par le patient
      match /suivis/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create: if peutCle(cle) || isSuivi();
        allow update, delete: if peutCle(cle);
      }
    }

    // ---------- Code d'accès du patient et messagerie (version 2.29) ----------
    // Le code donné au patient (lien, QR, carte) est différent de l'identifiant du dossier.
    // Les comptes autorisés qui suivent vos patients voient l'identifiant, jamais le code :
    // ils ne peuvent donc pas lire la messagerie, rangée sous le code.
    function codeDe(code) { return get(/databases/$(database)/documents/codes/$(code)).data; }
    // Messagerie : le titulaire, ou le kiné du patient (jamais un compte qui le suit seulement)
    function sienCode(code) { return isOwner() || (isAutorise() && codeDe(code).kine == moi() && kineDe(patientDe(codeDe(code).cle)) == moi()); }

    match /codes/{code} {
      allow get: if true;                 // le patient retrouve son dossier avec son code
      allow list: if isOwner() || (isAutorise() && resource.data.kine == moi());
      allow create: if isOwner() || (isAutorise() && request.resource.data.kine == moi()
        && kineDe(patientDe(request.resource.data.cle)) == moi());
      allow update: if isOwner();
      allow delete: if isOwner() || (isAutorise() && resource.data.kine == moi());

      match /messages/{id} {
        allow read: if true;              // le chemin contient le code secret du patient
        allow create: if sienCode(code)
          || (exists(/databases/$(database)/documents/codes/$(code)) && isMessage());
        allow delete: if sienCode(code);
        allow update: if sienCode(code) || (resource.data.de == "kine"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lu"]));
      }
    }

    // Un message de patient : texte de taille raisonnable, non lu
    function isMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(["type", "sujet", "texte", "date", "lu"])
        && d.type in ["message", "bilan"]
        && d.texte is string && d.texte.size() > 0 && d.texte.size() <= 5000
        && (!("sujet" in d) || (d.sujet is string && d.sujet.size() <= 200))
        && d.date is int
        && d.lu == false;
    }

    // Un abonnement aux rappels : adresse de notification, heure choisie,
    // et éventuellement jours et heures personnels (mode « perso »)
    function isRappel() {
      let d = request.resource.data;
      return d.keys().hasOnly(["endpoint", "p256dh", "auth", "heure", "actif", "createdAt", "tz", "dernierEnvoi", "mode", "jours"])
        && d.endpoint is string && d.endpoint.size() <= 1000 && d.endpoint.matches("https://.*")
        && d.p256dh is string && d.p256dh.size() <= 200
        && d.auth is string && d.auth.size() <= 100
        && d.heure is number && d.heure >= 6 && d.heure <= 22
        && d.actif is bool
        && (!("tz" in d) || (d.tz is string && d.tz.size() <= 60))
        && (!("mode" in d) || d.mode in ["seances", "perso"])
        && (!("jours" in d) || (d.jours is map && d.jours.keys().hasOnly(["1", "2", "3", "4", "5", "6", "7"])));
    }

    // Une réponse de patient : type connu, taille raisonnable.
    // Carnet de marches (type « marche ») : jour (AAAA-MM-JJ), durée en minutes et/ou distance en km, ressenti.
    function isSuivi() {
      let d = request.resource.data;
      return d.keys().hasOnly(["type", "date", "notes", "qid", "nom", "reponses", "score", "unite", "sousScores", "jour", "minutes", "km", "ressenti"])
        && d.type in ["objectifs", "questionnaire", "marche"]
        && d.date is int
        && (!("jour" in d) || (d.jour is string && d.jour.size() == 10))
        && (!("minutes" in d) || (d.minutes is number && d.minutes > 0 && d.minutes <= 600))
        && (!("km" in d) || (d.km is number && d.km > 0 && d.km <= 100))
        && (!("ressenti" in d) || (d.ressenti is string && d.ressenti.size() <= 30))
        && (!("reponses" in d) || (d.reponses is list && d.reponses.size() <= 120))
        && (!("score" in d) || d.score is number);
    }

    // Coordonnées, note privée et notes de séance : réservées au kiné
    match /fiches/{cle} {
      allow get, write: if peutCle(cle);
      allow list: if listeOk();
      // Notes de séance : privées, le kiné du patient seulement
      match /notes/{id} {
        allow read, write: if sienCle(cle);
      }
    }

    // Vues d'ensemble (tableau de bord, statistiques, sauvegarde) : le titulaire.
    // Les autres comptes lisent patient par patient (règles ci-dessus).
    match /{path=**}/suivis/{id} {
      allow read: if isOwner();
    }
    match /{path=**}/notes/{id} {
      allow read: if isOwner();
    }
    match /{path=**}/messages/{id} {
      allow read: if isOwner();
    }
    // Corbeille des programmes supprimés (30 jours) : gérée par le titulaire
    match /corbeille/{id} {
      allow create: if isKine();
      allow read, update, delete: if isOwner();
    }
    match /{path=**}/rappels/{id} {
      allow read: if isOwner();
    }

    // Questionnaires et fiches conseils : lus par les patients, écrits par le kiné
    match /questionnaires/{id} {
      allow read: if true;
      allow write: if isKine();
    }
    match /conseils/{id} {
      allow read: if true;
      allow write: if isKine();
    }

    // Vue d'ensemble de toutes les séances (tableau de bord du kiné)
    match /{path=**}/seances/{id} {
      allow read: if isOwner();
    }

    // Bilans kiné : jamais lisibles par les patients ; champ kine comme le patient
    match /bilans/{id} {
      allow get: if isOwner() || (isAutorise() && peutVoir(resource.data));
      allow list: if listeOk();
      allow create, update: if isOwner() || (isAutorise() && (request.resource.data.kine == moi() || (delegue() && request.resource.data.kine == owner())));
      allow delete: if isOwner() || (isAutorise() && peutVoir(resource.data));
    }

    // Programmes modèles du cabinet
    match /modeles/{id} {
      allow read, write: if isKine();
    }

    // Corrections du kiné sur la bibliothèque d'exercices
    match /exercices/{id} {
      allow read, write: if isKine();
    }

    // Réglages du cabinet (nom, annonce, listes…) : lus par tous, modifiés par le titulaire
    match /reglages/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Comptes autorisés : lus par les kinés, modifiés par le titulaire seul
    match /acces/{id} {
      allow read: if isKine();
      allow write: if isOwner();
    }

    // Ancienne collection (avant migration) : réservée au kiné
    match /programmes/{id} {
      allow read, write: if isOwner();
    }
  }
}
