rules_version = '2';

// Règles de sécurité Firestore — Gabriel LAVEAU
// À copier dans la console Firebase : Firestore Database > Règles > Publier.
//
// Principe :
// - Le kiné (compte e-mail/mot de passe ci-dessous) lit et écrit tout.
// - Un patient n'accède qu'à son propre dossier, grâce à son code d'accès secret
//   (le code fait partie du chemin : patients/{code}). Sans le code, impossible de
//   lister ou de deviner les autres patients.
// - Un patient ne peut modifier que la validation de ses séances (fait / EVA / ressenti)
//   et les jours de ses séances à venir. Il peut ajouter ses réponses aux objectifs
//   et questionnaires, et écrire des messages à son kiné, sans pouvoir les modifier ensuite.

service cloud.firestore {
  match /databases/{database}/documents {

    function isKine() {
      return request.auth != null
        && request.auth.token.email in ["kine.laveau@gmail.com"];
    }

    // Champs qu'un patient a le droit de modifier sur une séance
    function isValidation() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(["terminee", "eva", "dateValidation", "ressenti", "commentaire", "dureeReelle"])
        && d.terminee == true
        && (!("eva" in d) || (d.eva is int && d.eva >= 0 && d.eva <= 10))
        && (!("commentaire" in d) || (d.commentaire is string && d.commentaire.size() <= 1000))
        && (!("ressenti" in d) || (d.ressenti is string && d.ressenti.size() <= 30));
    }

    // Le patient peut déplacer une séance non faite (changement de jours)
    function isReplanning() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
               .hasOnly(["datePrevue", "datePrevueTexte", "joursProgramme", "updatedAt"])
        && resource.data.terminee != true
        && d.datePrevue is string && d.datePrevue.size() <= 40
        && (!("joursProgramme" in d) || (d.joursProgramme is list && d.joursProgramme.size() <= 7));
    }

    match /patients/{cle} {
      allow get: if true;                 // seulement si on connaît le code exact
      allow list, create, update, delete: if isKine();

      match /seances/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create, delete: if isKine();
        allow update: if isKine() || isValidation() || isReplanning();
      }

      // Messages du patient au kiné (copie dans ApiKiné)
      match /messages/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create: if isKine() || isMessage();
        allow update, delete: if isKine();
      }

      // Objectifs notés et questionnaires remplis par le patient
      match /suivis/{id} {
        allow read: if true;              // le chemin contient déjà le code secret
        allow create: if isKine() || isSuivi();
        allow update, delete: if isKine();
      }
    }

    // Un message de patient : texte de taille raisonnable, non lu
    function isMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(["type", "sujet", "texte", "date", "lu"])
        && d.type in ["message", "bilan"]
        && d.texte is string && d.texte.size() > 0 && d.texte.size() <= 5000
        && (!("sujet" in d) || (d.sujet is string && d.sujet.size() <= 200))
        && d.date is int
        && d.lu == false;
    }

    // Une réponse de patient : type connu, taille raisonnable
    function isSuivi() {
      let d = request.resource.data;
      return d.keys().hasOnly(["type", "date", "notes", "qid", "nom", "reponses", "score", "unite", "sousScores"])
        && d.type in ["objectifs", "questionnaire"]
        && d.date is int
        && (!("reponses" in d) || (d.reponses is list && d.reponses.size() <= 120))
        && (!("score" in d) || d.score is number);
    }

    // Coordonnées, note privée et notes de séance : réservées au kiné
    match /fiches/{cle} {
      allow read, write: if isKine();
      match /notes/{id} {
        allow read, write: if isKine();
      }
    }

    // Vue d'ensemble des suivis et des notes (statistiques, sauvegarde)
    match /{path=**}/suivis/{id} {
      allow read: if isKine();
    }
    match /{path=**}/notes/{id} {
      allow read: if isKine();
    }
    match /{path=**}/messages/{id} {
      allow read: if isKine();
    }

    // Questionnaires et fiches conseils : lus par les patients, écrits par le kiné
    match /questionnaires/{id} {
      allow read: if true;
      allow write: if isKine();
    }
    match /conseils/{id} {
      allow read: if true;
      allow write: if isKine();
    }

    // Vue d'ensemble de toutes les séances (tableau de bord du kiné)
    match /{path=**}/seances/{id} {
      allow read: if isKine();
    }

    // Bilans kiné : jamais lisibles par les patients
    match /bilans/{id} {
      allow read, write: if isKine();
    }

    // Programmes modèles du cabinet
    match /modeles/{id} {
      allow read, write: if isKine();
    }

    // Corrections du kiné sur la bibliothèque d'exercices
    match /exercices/{id} {
      allow read, write: if isKine();
    }

    // Réglages du cabinet (nom, annonce, listes…) : lus par tous, modifiés par le kiné
    match /reglages/{id} {
      allow read: if true;
      allow write: if isKine();
    }

    // Ancienne collection (avant migration) : réservée au kiné
    match /programmes/{id} {
      allow read, write: if isKine();
    }
  }
}
